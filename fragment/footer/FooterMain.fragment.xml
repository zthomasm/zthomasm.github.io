<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <OverflowToolbar >
    
        <Button 
            text="zthomasm - {i18n>applicationVersion}"
            icon="sap-icon://ai"
            enabled="false"
        ></Button>

        <Button
            visible="{= ${adminSettings>/bDebugMode} }"
            text="DebugMode"
            icon="sap-icon://wrench"
            press="onDebugModePress"
        ></Button>

        <ToolbarSpacer/>

        <core:Icon
            src="sap-icon://record"
            color="{= ${userSettings>/bIsNetworkOnline} ? '#2b7d2b' : '#bb0000' }"
            visible="{userSettings>/bUserIsLoggedIn}"
            class="liveBlink"
        ></core:Icon>

        <Button 
            visible="{= !${userSettings>/bUserIsLoggedIn} }"
            text="Log In"
            icon="sap-icon://customer"
            press="onLogInPress"
        ></Button>

        <Button 
            visible="{= ${userSettings>/bUserIsLoggedIn} }"
            text="Log Out"
            icon="sap-icon://user-edit"
            press="onLogOutPress"
        ></Button>

        <core:Icon
            src="sap-icon://ai"
        ></core:Icon>
    
    
    </OverflowToolbar>
</core:FragmentDefinition>
