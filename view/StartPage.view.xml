<mvc:View controllerName="learninggame.controller.StartPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <Page id="page0010" title="{i18n>title}" titleAlignment="Center">


        <content>
        
            <VBox id="Start0010" class="sapUiSmallMargin" visible="{TopicModel>/topics/FIORI/bShowOnStartPage}">
            
                <Title text="Aktionen - {i18n>FIORI}" level="H1" id="Title0010"></Title>
                    <f:GridContainer class="sapUiSmallMargin">
                        <f:layout>
                            <f:GridContainerSettings
                                rowSize="11rem"
                                columnSize="11rem"
                                gap="1rem" />
                        </f:layout>


                        <!-- Tile 1 -->
                        <GenericTile
                            class="tileLayout"
                            header="{i18n>T0010}"
                            subheader="{i18n>FIORI}"
                            press=".onPressBeforeStartGame">
                            <TileContent footer="{i18n>user}">
                                <ImageContent src="sap-icon://da-2"></ImageContent>
                            </TileContent>
                        </GenericTile>


                        <!-- Tile 2 -->
                        <GenericTile
                            class="tileLayout"
                            header="{i18n>T0020}"
                            subheader="{i18n>FIORI}"
                            press=".onPressBeforeStartShowAllQuestions_FIORI">
                            <TileContent footer="{i18n>user}">
                                <ImageContent src="sap-icon://da-2"></ImageContent>
                            </TileContent>
                        </GenericTile>

                        <!-- Tile 3 -->
                        <GenericTile
                            visible="false"
                            class="tileLayout"
                            header="{i18n>T0030}"
                            subheader="{i18n>FIORI}"
                            press=".onPressAddQuestion">
                            <TileContent footer="{i18n>admin}">
                                <ImageContent src="sap-icon://da"></ImageContent>
                            </TileContent>
                        </GenericTile>

                    </f:GridContainer>


            </VBox>

            <VBox id="Start0020" class="sapUiSmallMargin" visible="{TopicModel>/topics/ABAP/bShowOnStartPage}">
            
                <Title text="Aktionen - {i18n>ABAP}" level="H1" id="Title0020"></Title>
                    <f:GridContainer class="sapUiSmallMargin">
                        <f:layout>
                            <f:GridContainerSettings
                                rowSize="11rem"
                                columnSize="11rem"
                                gap="1rem" />
                        </f:layout>


                        <!-- Tile 1 -->
                        <GenericTile
                            class="tileLayout"
                            header="{i18n>T0010}"
                            subheader="{i18n>ABAP}"
                            press=".onPressBeforeStartGameABAP">
                            <TileContent footer="{i18n>user}">
                                <ImageContent src="sap-icon://da-2"></ImageContent>
                            </TileContent>
                        </GenericTile>


                        <!-- Tile 2 -->
                        <GenericTile
                            class="tileLayout"
                            header="{i18n>T0020}"
                            subheader="{i18n>ABAP}"
                            press=".onPressBeforeStartShowAllQuestions_ABAP">
                            <TileContent footer="{i18n>user}">
                                <ImageContent src="sap-icon://da-2"></ImageContent>
                            </TileContent>
                        </GenericTile>

                        <!-- Tile 3 -->
                        <GenericTile
                            visible="false"
                            class="tileLayout"
                            header="{i18n>T0030}"
                            subheader="{i18n>ABAP}"
                            press=".onPressAddQuestionXX">
                            <TileContent footer="{i18n>admin}">
                                <ImageContent src="sap-icon://da"></ImageContent>
                            </TileContent>
                        </GenericTile>

                    </f:GridContainer>


            </VBox>

            <VBox id="Start0030" class="sapUiSmallMargin" visible="{TopicModel>/topics/ISTQBFV4/bShowOnStartPage}">
            
                <Title text="Aktionen - {i18n>ISTQBFV4}" level="H1" id="Title0030"></Title>
                    <f:GridContainer class="sapUiSmallMargin">
                        <f:layout>
                            <f:GridContainerSettings
                                rowSize="11rem"
                                columnSize="11rem"
                                gap="1rem" />
                        </f:layout>


                        <!-- Tile 1 -->
                        <GenericTile
                            class="tileLayout"
                            header="{i18n>T0010}"
                            subheader="{i18n>ISTQBFV4}"
                            press=".onPressBeforeStartGameISTQBFV4">
                            <TileContent footer="{i18n>user}">
                                <ImageContent src="sap-icon://da-2"></ImageContent>
                            </TileContent>
                        </GenericTile>


                        <!-- Tile 2 -->
                        <GenericTile
                            class="tileLayout"
                            header="{i18n>T0020}"
                            subheader="{i18n>ISTQBFV4}"
                            press=".onPressBeforeStartShowAllQuestions_ISTQBFV4">
                            <TileContent footer="{i18n>user}">
                                <ImageContent src="sap-icon://da-2"></ImageContent>
                            </TileContent>
                        </GenericTile>

                        <!-- Tile 3 -->
                        <GenericTile
                            visible="false"
                            class="tileLayout"
                            header="{i18n>T0030}"
                            subheader="{i18n>ISTQBFV4}"
                            press=".onPressAddQuestionXX">
                            <TileContent footer="{i18n>admin}">
                                <ImageContent src="sap-icon://da"></ImageContent>
                            </TileContent>
                        </GenericTile>

                    </f:GridContainer>


            </VBox>
        
        </content>

        <footer>
            <core:Fragment fragmentName="learninggame.fragment.FooterMain" type="XML" />
        </footer>

    </Page>
</mvc:View>