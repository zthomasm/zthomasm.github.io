<mvc:View
    controllerName="learninggame.controller.AllQuestions"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Page id="allQuestionsPage" enableScrolling="false" title="Alle Fragen zu einem Thema" titleAlignment="Center" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <ScrollContainer
                id="allQuestionsContainer"
                width="100%"
                height="90vh"
                vertical="true"
                horizontal="false"
                focusable="true"
                class="sapUiContentPadding">
                
                <VBox
                    id="allQuestionsContainerVBox"
                    width="100%"
                    class="sapUiContentPadding sapUiSmallMarginAuto"/>
            </ScrollContainer>
        </content>
        
        <footer>
            <core:Fragment fragmentName="learninggame.fragment.footer.FooterAllQuestions" type="XML" />
        </footer>
    </Page>
</mvc:View>
