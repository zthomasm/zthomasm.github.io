<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Toolbar>
    
        <ProgressIndicator 
            id="scrollProgress"
            width="100%" 
            height="4px"
            displayValue=""
            showValue="false"
            state="Information" />
        <ToolbarSpacer/>
        
        <core:Icon
            src="sap-icon://record"
            color="{= ${userSettings>/bIsNetworkOnline} ? '#2b7d2b' : '#bb0000' }"
            visible="{userSettings>/bUserIsLoggedIn}"
            class="liveBlink"
        ></core:Icon>

        <Button 
            enabled="false"
            text="{= ${quiz>/questions}.length } Fragen zum Thema"
        ></Button>


    
    </Toolbar>
</core:FragmentDefinition>
