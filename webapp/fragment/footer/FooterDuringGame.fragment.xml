<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <OverflowToolbar>

        <core:Icon
            src="sap-icon://ai"
        ></core:Icon>

        <Text id="footerPercentText" text="" class="footerProgressPercent"/>
        
        <ToolbarSpacer/>

        <Button 
            id="footerButtonTimer0010"
            visible="{Timer>/bTimerActivated}"
            text="Timer"
            press=".onShowTimerPopover"
            type="Neutral"
            icon="sap-icon://pending"
        ></Button>

        <ToolbarSpacer/>
        
        <CheckBox 
            text="TCA"
            selected="{GameSettings>/bTCA}"
        ></CheckBox>

        <core:Icon
            src="sap-icon://ai"
        ></core:Icon>

    </OverflowToolbar>
</core:FragmentDefinition>
