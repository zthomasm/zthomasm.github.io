<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <OverflowToolbar>
    
        <HBox id="footerProgress" class="footerProgressContainer" alignItems="Center" justifyContent="Center"/>
        
        <ToolbarSpacer/>

        <Button 
            id="footerButtonTimer0010"
            visible="{Timer>/bTimerActivated}"
            text="Timer"
            press=".onShowTimerPopover"
            type="Neutral"
            icon="sap-icon://pending"
        ></Button>

        <ToolbarSpacer/>
        
        <CheckBox 
            text="TCA"
            selected="{GameSettings>/bTCA}"
        ></CheckBox>
    
    
    </OverflowToolbar>
</core:FragmentDefinition>
