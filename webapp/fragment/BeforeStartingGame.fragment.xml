<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog
    id="beforeStartingDialog"
    title="Bevor du startest"
    class="sapUiContentPadding"
    draggable="true"
    resizable="false"
    contentHeight="50%"
    contentWidth="50%">

    <VBox class="sapUiSmallMargin">

      <!-- Anzahl Fragen -->
      <Text text="Wie viele Fragen möchtest du beantworten?" visible="{= ${topicModel>/sMode} === 'gameMode' }" />
        <Slider
            visible="{= ${topicModel>/sMode} === 'gameMode' }"
            min="3"
            max="15"
            step="1"
            value="{topicModel>/numberOfQuestions}"
            liveChange=".onSliderChange"
            showAdvancedTooltip="true"
            showHandleTooltip="true"
        />
      <Text text="Anzahl: {topicModel>/numberOfQuestions}" visible="{= ${topicModel>/sMode} === 'gameMode' }" class="sapUiMediumMarginBottom" />

      <!-- Themenauswahl -->
      <Text text="Wähle Themenbereiche aus:" class="" />
        <HBox>
          <MultiComboBox
              visible="{= ${topicModel>/sMode} === 'gameMode' }"
              items="{topicModel>/availableTopics}"
              selectedKeys="{topicModel>/selectedTopics}"
              width="100%"
              showClearIcon="true">
              <core:Item key="{topicModel>key}" text="{topicModel>text}" />
          </MultiComboBox>

          <ComboBox
            visible="{= ${topicModel>/sMode} === 'showAllQuestions' }"
            items="{topicModel>/availableTopics}"
            selectedKey="{topicModel>/singleTopic}"
            width="100%"
            showClearIcon="true">
            <core:Item key="{topicModel>key}" text="{topicModel>text}" />
          </ComboBox>
        </HBox>
        <HBox class="sapUiSmallMarginTop" visible="{= ${topicModel>/sMode} === 'gameMode' }">
            <Button text="Alle selektieren" press=".onSelectAllTopics" type="Accept"/>
            <Button text="Alle deselektieren" press=".onDeselectAllTopics" type="Reject" class="sapUiTinyMarginBegin"/>
        </HBox>

      <!-- HelpOfAI-Auswahl -->
      <Text text="Helpende KI" class="sapUiMediumMarginTop" />

        <VBox>
          <SegmentedButton 
            selectedKey="{AIModels>/selectedAI}" 
            items="{
              path: 'AIModels>/availableAI'
              }" 
            >
            <items>
              <SegmentedButtonItem key="{AIModels>key}" text="{AIModels>text}" />
            </items>
          </SegmentedButton>
        </VBox>

        <!-- <Button text="Debug" press=".onDebug"></Button> -->

    </VBox>

    <endButton>
        <Button text="Abbrechen" press=".onCancelDialog" />
    </endButton>
    <beginButton>
        <Button text="Beginnen" type="Emphasized" press=".onConfirmDialog" />
    </beginButton>

  </Dialog>
</core:FragmentDefinition>
