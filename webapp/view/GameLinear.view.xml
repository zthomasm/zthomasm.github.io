<mvc:View
    controllerName="learninggame.controller.GameLinear"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

<Page id="gamePage" enableScrolling="false">
    <content>
    
        <ScrollContainer
            id="quizContainer"
            width="100%"
            height="90vh"
            vertical="true"
            horizontal="false"
            focusable="true"
            class="sapUiContentPadding">
            
            <VBox
                id="quizContainerVBox"
                width="100%"
                class="sapUiContentPadding sapUiSmallMarginAuto"/>
                
        </ScrollContainer>
    </content>

    <footer>
        <core:Fragment fragmentName="learninggame.fragment.FooterDuringGame" type="XML" />
    </footer>
</Page>
    
</mvc:View>
